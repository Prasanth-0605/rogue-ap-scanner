/* RogueHunter TUI — Theme: github-dark
 *
 * GitHub-inspired dark theme. Deep dark backgrounds, subtle borders,
 * blue accents, and clean typography.  Severity is conveyed purely through
 * the STATUS label: green = trusted/OK, yellow = suspicious,
 * red = high risk.  No icons or emojis.
 */

Screen {
    layout: vertical;
    background: #0d1117;
    color: #c9d1d9;
}

Header {
    background: #161b22;
    color: #2386f6;
    text-style: bold;
    dock: top;
    border-bottom: tall #30363d;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
    border-top: tall #30363d;
}

.page-title {
    text-style: bold;
    color: #2386f6;
    margin: 1 1 0 1;
}

.hint {
    color: #8b949e;
    margin: 0 1 1 1;
}

.section-title {
    text-style: bold;
    color: #2ea043;
    margin: 1 1 0 1;
}

#dashboard-title {
    text-style: bold;
    color: #2386f6;
    margin: 1 1 0 1;
}

#status-bar {
    layout: horizontal;
    margin: 0 1;
    height: auto;
    background: #161b22;
    border: tall #30363d;
    padding: 0 1;
}

.pill {
    background: #2386f6;
    color: #0d1117;
    padding: 0 1;
    margin-right: 1;
    width: auto;
    text-style: bold;
}

#action-bar {
    layout: horizontal;
    margin: 1 1 0 1;
    height: auto;
}

#action-bar Button {
    margin-right: 1;
}

APTable {
    margin: 0 1 1 1;
    height: 1fr;
    border: tall #30363d;
    background: #0d1117;
}

#ap-table-title {
    text-style: bold;
    color: #2ea043;
    margin: 0 1 0 1;
}

#ap-header {
    layout: horizontal;
    background: #161b22;
    color: #8b949e;
    text-style: bold;
    padding: 0 1;
    height: auto;
    border-bottom: tall #30363d;
}

.header-cell {
    width: 1fr;
    padding: 0 1;
}

#ap-list {
    height: 1fr;
}

APRow {
    layout: horizontal;
    height: auto;
    width: 100%;
    padding: 0 1;
    margin: 0 0 1 0;
    background: #0d1117;
}

APRow .chip {
    width: 8;
    text-align: center;
    text-style: bold;
    padding: 0 1;
    background: #2386f6;
    color: #0d1117;
}

APRow .cell {
    width: 1fr;
    padding: 0 1;
}

/* Default cell text (works on green and red rows) */
APRow .cell-default {
    color: #c9d1d9;
}

/* Dark text for high-contrast on yellow/suspicious rows */
APRow .cell-suspicious {
    color: #0d1117;
}

#alerts-box {
    height: 12;
    border: tall #30363d;
    margin: 0 1 1 1;
    padding: 0 1;
    overflow-y: scroll;
    background: #161b22;
}

#alert-ticker {
    width: 1fr;
}

/* Trusted / Alerts / Reports screens */

.trusted-row {
    padding: 0 1;
    margin: 0 0 1 0;
    background: #161b22;
    border: tall #30363d;
}

/* --- Alert cards --- */
.alert-card {
    layout: vertical;
    padding: 1;
    margin: 0 0 1 0;
    background: #161b22;
    border: tall #30363d;
}

.alert-card Horizontal {
    height: auto;
    margin: 0;
}

.alert-time {
    color: #8b949e;
    text-style: bold;
    width: 10;
}

.sev-badge {
    width: 1fr;
    text-align: center;
}

.alert-score {
    color: #2ea043;
    text-align: right;
    width: 12;
}

.alert-rule {
    color: #c9d1d9;
    text-style: bold;
    width: 1fr;
}

.alert-ident {
    color: #8b949e;
    width: 1fr;
    text-align: right;
}

.alert-expl {
    color: #c9d1d9;
    margin: 0 1 0 1;
    padding: 0 1;
    text-style: italic;
}

.empty-msg {
    color: #8b949e;
    margin: 2 2;
    text-align: center;
}

#trusted-list,
#alerts-list {
    height: 1fr;
    overflow-y: scroll;
}

.form-label {
    width: 12;
    padding: 1 0;
    text-align: right;
    color: #2386f6;
}

#form-row-1,
#form-row-2 {
    layout: horizontal;
    margin: 0 1;
    height: auto;
}

#form-row-1 Input,
#form-row-2 Input {
    margin-right: 1;
    background: #0d1117;
    color: #c9d1d9;
    border: tall #30363d;
}

#trusted-actions,
#alerts-actions,
#reports-actions {
    layout: horizontal;
    margin: 1 1 0 1;
    height: auto;
}

#trusted-actions Button,
#alerts-actions Button,
#reports-actions Button {
    margin-right: 1;
}

#alerts-bulk-actions {
    layout: horizontal;
    margin: 0 1 0 1;
    height: auto;
}

#alerts-summary {
    color: #2ea043;
    text-style: bold;
}

#report-status {
    margin: 1 1 0 1;
    color: #2ea043;
    text-style: bold;
}

/* Button styling consistent with GitHub theme */
Button {
    background: #2386f6;
    color: #ffffff;
    border: tall #30363d;
}

Button:hover {
    background: #2ea043;
    color: #ffffff;
}

Button:focus {
    background: #2ea043;
    border: tall #ffffff;
}

Button.variant-warning {
    background: #d29922;
    color: #ffffff;
}

Button.variant-error {
    background: #f85149;
    color: #ffffff;
}

Button.variant-success {
    background: #2ea043;
    color: #ffffff;
}

Button.variant-primary {
    background: #2386f6;
    color: #ffffff;
}
